{
  "name": "wxata",
  "version": "2.0.0",
  "description": "FOSS WhatsApp Bot Platform with Bun + Baileys",
  "main": "index.js",
  "scripts": {
    "frontend": "cd frontend && bun dev",
    "backend": "cd backend && bun run index.ts",
    "all": "concurrently \"bun run frontend\" \"bun run backend\"",
    "install:all": "bun install && cd frontend && bun install && cd ../backend && bun install",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop wxata",
    "pm2:restart": "pm2 restart wxata",
    "pm2:logs": "pm2 logs wxata",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete wxata",
    "type-check": "bun run frontend:type-check && bun run backend:type-check",
    "frontend:type-check": "cd frontend && bun run type-check",
    "backend:type-check": "cd backend && bun run type-check",
    "prepare": "husky"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "bun",
    "foss",
    "self-hosted"
  ],
  "author": "TADS Tech",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  }
}
