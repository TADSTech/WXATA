# ── WXATA Environment Configuration ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Port for the backend HTTP & WebSocket server
PORT=5000

# Message retention (days) for local SQLite cache
DB_RETENTION_DAYS=3

# ── Supabase (optional — for marketplace/extensions) ──────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase (optional — for user profiles/extensions) ────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Frontend Config ───────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:5000/ws

# ── Admin Password (optional — protects WebSocket bot-info updates) ───────────
VITE_ADMIN_PASS=
