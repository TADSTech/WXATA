# ── WXATA Environment Configuration ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Port for the backend HTTP & WebSocket server
PORT=5000

# Dashboard auth password (leave empty or remove to disable auth)
DASHBOARD_PASSWORD=

# Message retention (days) for local SQLite cache
DB_RETENTION_DAYS=3

# ── Frontend Config ───────────────────────────────────────────────────────────
VITE_BACKEND_URL=ws://localhost:5000
