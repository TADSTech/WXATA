# Port for the backend HTTP & WebSocket server
# This can be changed if you want the server to run on a port other than 5000.
PORT=5000
DB_RETENTION_DAYS=3

# ── Firebase (Admin SDK) ──────────────────────────────────────────────────────
# Service-account credentials for firebase-admin (used for the backend REST API
# and Flutterwave webhooks). Obtain these from the Firebase Console:
#   Project settings → Service accounts → Generate new private key
# FIREBASE_PRIVATE_KEY must use \n escaped newlines (as emitted by the console).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...==\n-----END PRIVATE KEY-----\n

# ── Flutterwave ───────────────────────────────────────────────────────────────
FLW_SECRET_HASH=your-flutterwave-secret-hash-here
VITE_FLW_PUBLIC_KEY = FLWPUBK-your-actual-public-key-hereo

# ── License ───────────────────────────────────────────────────────────────────
# Random 32-byte hex secret used to sign license keys
LICENSE_HMAC_SECRET=your-32-byte-hex-license-hmac-secret-here
# Admin secret for the /admin/generate-license endpoint
ADMIN_SECRET=your-admin-secret-here
# License key for the production/public build (format: username:hmac_hex)
LICENSE_KEY=your-username:your-license-hmac-hex-here

# ── SMTP (transactional email) ────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password-here
SMTP_FROM="WXATA <noreply@yourdomain.com>"
