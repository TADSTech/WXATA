# ── WXATA Backend Configuration ────────────────────────────────────────────────
# Port for the backend HTTP & WebSocket server
PORT=5000

# Message retention (days) for local SQLite cache
DB_RETENTION_DAYS=3

# ── Firebase (optional — for user profiles/extensions) ────────────────────────
# Service-account credentials for firebase-admin. Obtain from:
#   Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_PRIVATE_KEY must use \n escaped newlines (as emitted by the console).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...==\n-----END PRIVATE KEY-----\n
