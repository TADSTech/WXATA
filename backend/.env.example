# Port for the backend HTTP & WebSocket server
# This can be changed if you want the server to run on a port other than 5000.
PORT=5000
DB_RETENTION_DAYS=3

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PLAN_HOSTED_INITIAL=PLN_your_initial_plan_id
PAYSTACK_PLAN_HOSTED_RECURRING=PLN_your_recurring_plan_id

# ── License ───────────────────────────────────────────────────────────────────
# Random 32-byte hex secret used to sign license keys
LICENSE_HMAC_SECRET=your_random_32_byte_hex_secret_here
# Admin secret for the /admin/generate-license endpoint
ADMIN_SECRET=your_admin_secret_here
# License key for the production/public build (format: username:hmac_hex)
LICENSE_KEY=<username>:<hmac_hex>

# ── SMTP (transactional email) ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="WXATA <noreply@example.com>"
