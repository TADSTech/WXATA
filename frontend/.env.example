# WebSocket URL for the WXATA backend
# Local dev:
#   VITE_BACKEND_URL=ws://localhost:5000
# Oracle VPS with Caddy TLS (recommended for production):
#   VITE_BACKEND_URL=wss://your.domain.com
# Oracle VPS without a domain (not usable from HTTPS frontend):
#   Not possible — browsers block ws:// from HTTPS pages (Mixed Content)
VITE_BACKEND_URL=ws://localhost:5000
